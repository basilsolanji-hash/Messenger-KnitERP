# Template only. Generate real values with: python3 scripts/init-dev.py
# Never commit .env, never pass these values on a command line, never print them.
ASPNETCORE_ENVIRONMENT=Development
POSTGRES_PASSWORD=
ConnectionStrings__Messenger=Host=db;Port=5432;Database=messenger;Username=messenger;Password=
# base64 of >= 32 random bytes each; all four must differ.
Auth__SigningKey=
Auth__PhoneIndexKey=
Auth__SmsCodeKey=
Auth__PinPepper=
# Fake (Development only, no network) or SmsRu.
Auth__Sms__Provider=Fake
# Only with Provider=SmsRu, only from the server's secret store:
# Auth__Sms__SmsRu__ApiKey=
# Auth__Sms__SmsRu__From=
# Exact reverse-proxy addresses allowed to set X-Forwarded-For, e.g.:
# Auth__TrustedProxies__0=10.0.0.2
# Disabled by default. Enable only for isolated synthetic operator tests, with a random key.
Dev__EnableOperatorEndpoints=false
Dev__ProvisioningKey=
Dev__AutoMigrate=true
